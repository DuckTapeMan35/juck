// The number and string built-ins.
[
  ["print", ["i64-to-f64", 3]],
  ["print", ["f64-to-i64", 2.9]],
  ["print", ["f64-to-i64", -2.9]],
  ["print", ["i64-to-str", -42]],
  ["print", ["f64-to-str", 1.5]],
  ["print", ["f64-to-str", 2.0]],

  ["print", ["str-len", {"str": "h\u00e9"}]],
  ["print", ["str-concat", {"str": "ab"}, {"str": "cd"}]],
  ["print", ["str-slice", {"str": "hello"}, 1, 3]],
  ["print", ["str-len", ["str-slice", {"str": "h\u00e9!"}, 1, 3]]],
  ["print", ["str-slice", {"str": "abc"}, 3, 3]],
  ["print", ["str-byte", {"str": "A"}, 0]],
  ["print", ["str-byte", {"str": "\u00e9"}, 0]],
  ["print", ["str-from-byte", 97]],
]
