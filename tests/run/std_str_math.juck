// std/str and std/math.
[
  ["import", "str", "std/str"],
  ["import", "math", "std/math"],

  ["print", ["str.starts-with?", {"str": "hello"}, {"str": "he"}]],
  // No error, even though slicing "é" after one byte would split it.
  ["print", ["str.starts-with?", {"str": "\u00e9"}, {"str": "a"}]],
  ["print", ["str.ends-with?", {"str": "hello"}, {"str": "llo"}]],
  ["print", ["str.ends-with?", {"str": "lo"}, {"str": "hello"}]],
  ["print", ["str.index-of", {"str": "hello"}, {"str": "l"}]],
  ["print", ["str.index-of", {"str": "hello"}, {"str": "z"}]],
  ["print", ["str.index-of-from", {"str": "hello"}, {"str": "l"}, 3]],
  ["print", ["str.contains?", {"str": "hello"}, {"str": "ell"}]],
  ["print", ["str.repeat", {"str": "ab"}, 3]],
  ["print", ["str.trim", {"str": "  hi there \n"}]],
  ["print", ["str.trim-start", {"str": "\t x "}]],
  ["print", ["str.trim-end", {"str": " x \t"}]],
  ["print", ["str.trim", {"str": "   "}]],
  ["print", ["str.upper", {"str": "Hello, World!"}]],
  ["print", ["str.lower", {"str": "Hello, World!"}]],
  ["print", ["str.len", {"str": "abc"}]],

  ["print", ["math.abs", -5]],
  ["print", ["math.sign", -5]],
  ["print", ["math.min", 3, 7]],
  ["print", ["math.max", 3, 7]],
  ["print", ["math.clamp", 15, 0, 10]],
  ["print", ["math.pow", 2, 10]],
  ["print", ["math.pow", 3, 0]],
  ["print", ["math.pow", -2, 3]],
  ["print", ["math.pow", 10, 18]],
  ["print", ["math.pow", 2, -1]],
  ["print", ["math.pow", -1, -3]],
  ["print", ["math.floor", 2.5]],
  ["print", ["math.floor", -2.5]],
  ["print", ["math.ceil", 2.1]],
  ["print", ["math.round", 2.5]],
  ["print", ["math.round", -2.5]],
  ["print", ["math.round", 2.4]],
  ["print", ["math.trunc", -2.7]],
  ["print", "math.pi"],
]
