// Function bodies may call functions defined later, including each other.
[
  ["fn", {"name": "even?", "params": [["n", "i64"]], "returns": "bool"},
    ["if", ["=", "n", 0], true, ["odd?", ["-", "n", 1]]]],
  ["fn", {"name": "odd?", "params": [["n", "i64"]], "returns": "bool"},
    ["if", ["=", "n", 0], false, ["even?", ["-", "n", 1]]]],
  ["print", ["even?", 10]],
]
