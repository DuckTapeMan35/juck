// Every v1 feature, at least once.
[
  ["def", {"name": "pi", "type": "f64"}, 3.14159],
  ["def", {"name": "greeting", "type": "str"}, {"str": "hello, \"world\"\n\u00e9"}],
  ["def", {"name": "nothing", "type": "null"}, null],

  ["fn", {"name": "add", "params": [["a", "i64"], ["b", "i64"]], "returns": "i64",
          "doc": "Adds two integers."},
    ["+", "a", "b"]],

  ["fn", {"name": "fact", "params": [["n", "i64"]], "returns": "i64"},
    ["if", ["<=", "n", 1],
      1,
      ["*", "n", ["fact", ["-", "n", 1]]]]],

  ["fn", {"name": "make-adder",
          "params": [["n", "i64"]],
          "returns": {"fn": {"params": ["i64"], "returns": "i64"}}},
    ["lambda", {"params": [["x", "i64"]], "returns": "i64"},
      ["+", "x", "n"]]],

  ["let", [["x", "i64", 1], ["y", "i64", ["+", "x", 1]]],
    ["print", ["*", "x", "y"]]],

  ["do", ["print", ["fact", 5]], ["print", [["make-adder", 1], 41]]],

  ["print", ["data", ["+", "a", 1]]],
  ["print", ["data", "a-symbol"]],
]
